%3
clear; close all;

f0 = 10; % центральная частота, чтобы Δf было мало
df_list = [0.5, 0.3, 0.1, 0.01];
A = 1; phi = 0;
Fs = 100; % высокая частота, чтобы не влиять

for k = 1:length(df_list)
    df = df_list(k);
    f1 = f0 - df/2;
    f2 = f0 + df/2;
    
    sig = @(x) A*sin(2*pi*f1*x + phi) + A*sin(2*pi*f2*x + phi);
    
    % Поиск минимального Tl
    Tl_vals = 1./df * [0.5, 1, 2, 5]; % кратно 1/df
    figure;
    
    for i = 1:length(Tl_vals)
        Tl = Tl_vals(i);
        t = 0:1/Fs:Tl;
        s = sig(t);
        
        Y = fft(s, length(s)) / length(s);
        fc = Fs/2 * linspace(0, 1, length(s)/2 + 1);
        
        subplot(2,2,i);
        plot(fc, 2*abs(Y(1:length(s)/2+1)), 'b');
        title(['\Deltaf = ', num2str(df), ' Гц, T_l = ', num2str(Tl), ' c']);
        xlabel('f, Гц'); ylabel('|S(f)|');
        xlim([f0 - 2*df, f0 + 2*df]);
        grid on;
    end
    sgtitle(['Разрешение по частоте: \Deltaf = ', num2str(df), ' Гц']);
end