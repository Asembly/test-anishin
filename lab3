%3
clear; close all;

f0 = 10; % центральная частота, чтобы Δf было мало
df_list = [0.5, 0.3, 0.1, 0.01];
A = 1; phi = 0;
Fs = 100; % высокая частота, чтобы не влиять

for k = 1:length(df_list)
    df = df_list(k);
    f1 = f0 - df/2;
    f2 = f0 + df/2;
    
    sig = @(x) A*sin(2*pi*f1*x + phi) + A*sin(2*pi*f2*x + phi);
    
    % Поиск минимального Tl
    Tl_vals = 1./df * [0.5, 1, 2, 5]; % кратно 1/df
    figure;
    
    for i = 1:length(Tl_vals)
        Tl = Tl_vals(i);
        t = 0:1/Fs:Tl;
        s = sig(t);
        
        Y = fft(s, length(s)) / length(s);
        fc = Fs/2 * linspace(0, 1, length(s)/2 + 1);
        
        subplot(2,2,i);
        plot(fc, 2*abs(Y(1:length(s)/2+1)), 'b');
        title(['\Deltaf = ', num2str(df), ' Гц, T_l = ', num2str(Tl), ' c']);
        xlabel('f, Гц'); ylabel('|S(f)|');
        xlim([f0 - 2*df, f0 + 2*df]);
        grid on;
    end
    sgtitle(['Разрешение по частоте: \Deltaf = ', num2str(df), ' Гц']);
end


clear; close all;

% Параметры
Fs = 200;           % высокая частота дискретизации (чтобы не влиять)
f_center = 10;      % центральная частота

% Разности частот (Δf)
df_list = [0.5, 0.3, 0.1, 0.01];

for k = 1:length(df_list)
    df = df_list(k);
    
    % Две гармоники с разностью df
    f1 = f_center - df/2;
    f2 = f_center + df/2;
    
    % Длительности, кратные 1/df
    Tl_vals = [0.5/df, 1/df, 2/df, 4/df];
    
    figure('Position', [100, 100, 1200, 800]);
    sgtitle(['Δf = ', num2str(df), ' Гц']);
    
    for i = 1:length(Tl_vals)
        Tl = Tl_vals(i);
        t = 0:1/Fs:Tl;
        
        % Сигнал: сумма двух синусоид
        s = sin(2*pi*f1*t) + sin(2*pi*f2*t);
        
        % Спектр
        Y = fft(s);
        n = length(s);
        Y_mag = abs(Y(1:floor(n/2)+1)) / n * 2;
        freq = (0:floor(n/2)) * (Fs / n);
        
        subplot(2, 2, i);
        plot(freq, Y_mag, 'b', 'LineWidth', 1.5);
        title(sprintf('T_l = %.2f c  (%.1f / Δf)', Tl, Tl*df));
        xlabel('f, Гц');
        ylabel('|S(f)|');
        xlim([f_center - 2*df, f_center + 2*df]);
        ylim([0, 1.2]);
        grid on;
        
        % Отметить истинные частоты
        xline(f1, 'r--', sprintf('f1=%.3f', f1), 'LabelOrientation', 'horizontal');
        xline(f2, 'r--', sprintf('f2=%.3f', f2), 'LabelOrientation', 'horizontal');
    end
end


%Индивидуалка
pkg load signal; % Загрузка пакета

% 1. Параметры времени
fs = 1000;              
t = 0:1/fs:12;          

% 2. Параметры импульсов (центры, ширина, амплитуда)
centers    = [1.5,  3.5,  5.0,  6.5,  8.0, 10.5]; 
widths     = [1.5,  1.5,  0.8,  0.8,  1.5,  1.5]; 
amplitudes = [2.0,  2.0,  1.0,  1.0,  2.0,  2.0]; 

% 3. Генерация сигнала
signal = zeros(size(t));
for i = 1:length(centers)
    signal = signal + amplitudes(i) * tripuls(t - centers(i), widths(i));
end

% 4. Визуализация с разметкой осей
