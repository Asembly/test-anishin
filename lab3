clear; close all;

%% ========== Пункт 1 ==========
% Аналитический сигнал: f1=1 Гц, A=1, фаза pi/4, Tl=10
f1 = 1;
A1 = 1;
phi1 = pi/4;
Tl = 10;

% Частоты дискретизации
Fs_list = [1, 3, 5, 20];

% Непрерывное время для аналитического сигнала (высокое разрешение)
t_cont = linspace(0, Tl, 10000);
s_cont = A1 * sin(2*pi*f1*t_cont + phi1);

figure('Position', [50, 500, 1200, 400]);

% Графики сигналов (пункт 1)
for i = 1:length(Fs_list)
    Fs = Fs_list(i);
    t_disc = 0:1/Fs:Tl;
    s_disc = A1 * sin(2*pi*f1*t_disc + phi1);
    
    subplot(2, 4, i);
    plot(t_cont, s_cont, 'b-', 'LineWidth', 1); hold on;
    stem(t_disc, s_disc, 'r', 'LineWidth', 1.5, 'MarkerSize', 4);
    title(sprintf('Fs = %d Гц', Fs));
    xlabel('t, c'); ylabel('s(t)');
    grid on;
    legend('аналоговый', 'дискретный', 'Location', 'best');
    
    % Спектр (амплитудный)
    subplot(2, 4, i+4);
    N = length(s_disc);
    Y = fft(s_disc);
    Y_mag = abs(Y(1:floor(N/2)+1)) / N * 2;
    freq = (0:floor(N/2)) * (Fs / N);
    stem(freq, Y_mag, 'b', 'LineWidth', 1.5, 'MarkerSize', 4);
    xlabel('f, Гц'); ylabel('|S(f)|');
    title(sprintf('Спектр, Fs = %d Гц', Fs));
    xlim([0, Fs/2 + 0.5]);
    grid on;
    yline(1, 'r--', 'A=1');
end
sgtitle('Пункт 1: сигнал 1 Гц, фаза π/4');

