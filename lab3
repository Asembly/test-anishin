%% ========== Пункт 3 ==========
% Сумма 2 гармоник с девиацией Δf, f_center = 2 Гц
f_center = 2;
df_list = [0.5, 0.3, 0.1, 0.01];
phi1_3 = 0;
phi2_3 = pi/8;
Tl = 10;  % фиксированная длительность для начала
Fs_high = 50; % высокая частота для анализа (чтобы не влиять на разрешение)

figure('Position', [100, 100, 1200, 800]);

for k = 1:length(df_list)
    df = df_list(k);
    f1_3 = f_center - df/2;
    f2_3 = f_center + df/2;
    
    % Дискретизация с высокой частотой (чтобы увидеть истинный спектр)
    t = 0:1/Fs_high:Tl;
    s = sin(2*pi*f1_3*t + phi1_3) + sin(2*pi*f2_3*t + phi2_3);
    
    N = length(s);
    Y = fft(s);
    Y_mag = abs(Y(1:floor(N/2)+1)) / N * 2;
    freq = (0:floor(N/2)) * (Fs_high / N);
    
    subplot(2, 2, k);
    plot(freq, Y_mag, 'b', 'LineWidth', 1.5);
    title(sprintf('Δf = %.2f Гц, T_l = %d c, F_s = %d Гц', df, Tl, Fs_high));
    xlabel('f, Гц'); ylabel('|S(f)|');
    xlim([f_center - 2, f_center + 2]);
    grid on;
    hold on;
    xline(f1_3, 'r--', sprintf('%.3f', f1_3));
    xline(f2_3, 'r--', sprintf('%.3f', f2_3));
    
    % Находим минимальное Tl, при котором видны оба пика
    % Теоретически: Tl_min = 1/df
    Tl_min = 1/df;
    text(f_center, max(Y_mag)*0.8, sprintf('T_l,min = %.2f c', Tl_min), ...
        'HorizontalAlignment', 'center', 'BackgroundColor', 'w');
end
sgtitle('Пункт 3: разрешение спектральных составляющих');

